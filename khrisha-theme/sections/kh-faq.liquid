{%- comment -%}
  FAQ accordion.
  Source: custom.faqs (list of `faq` metaobjects with `question` + `answer` rich text).
  Fallback: the section's question blocks, edited in the theme editor.
{%- endcomment -%}
{%- assign faqs = product.metafields.custom.faqs.value -%}
{%- if faqs != blank or section.blocks.size > 0 -%}
<div class="kh">
  <section class="guide-band section-space">
    <div class="kh-wrap guide-inner">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <div class="question-list">
        {%- if faqs != blank -%}
          {%- for faq in faqs -%}
            <details>
              <summary>{{ faq.question.value }}<span aria-hidden="true">+</span></summary>
              <div class="answer">{{ faq.answer | metafield_tag }}</div>
            </details>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}<span aria-hidden="true">+</span></summary>
              <div class="answer">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Khrisha FAQ",
  "tag": "section",
  "class": "kh-section",
  "settings": [
    { "type": "paragraph", "content": "Shows the product's custom.faqs metafield (FAQ metaobjects). When it is empty, the question blocks below are used." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your questions, answered" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I sample it first?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Explore the sampling options for this fragrance at our online boutique.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Khrisha FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
