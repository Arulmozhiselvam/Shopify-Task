{%- comment -%}
  "Others also considered". Hand-picked products come from either:
    - custom.related_products: list of products, or
    - custom.custom_related_product: list of `custom_product` metaobjects whose
      `name` field holds one or more products.
  When neither is filled it lazy-loads Shopify's product recommendations through
  this same section (the Section Rendering API sets `recommendations`).
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign picked = product.metafields.custom.related_products.value
  if picked == blank
    assign entries = product.metafields.custom.custom_related_product.value
    for entry in entries
      assign entry_products = entry.name.value
      if entry_products == blank
        continue
      endif
      if picked == blank
        assign picked = entry_products
      else
        assign picked = picked | concat: entry_products
      endif
    endfor
  endif
-%}
<div class="kh">
  {%- if recommendations.performed? -%}
    <kh-recommendations>
      <div class="related-grid">
        {%- for rec in recommendations.products limit: limit -%}
          {%- render 'kh-product-card', card_product: rec -%}
        {%- endfor -%}
      </div>
    </kh-recommendations>
  {%- else -%}
    <section class="kh-wrap section-space shopping-section" {% if picked == blank %}hidden data-hide-when-empty{% endif %}>
      <div class="section-heading">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      {%- if picked != blank -%}
        <div class="related-grid">
          {%- for rel in picked limit: limit -%}
            {%- render 'kh-product-card', card_product: rel -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <kh-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"></kh-recommendations>
      {%- endif -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Khrisha related products",
  "tag": "section",
  "class": "kh-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Others also considered" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Shows the products in the custom.related_products metafield. When it is empty, Shopify's automatic recommendations are used." }
  ],
  "presets": [{ "name": "Khrisha related products" }]
}
{% endschema %}
