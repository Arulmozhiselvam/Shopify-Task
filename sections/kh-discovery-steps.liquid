{%- comment -%}
  Steps source: custom.steps (list of `discovery_step` metaobjects: icon, title, text).
  Image: custom.steps_image. Both fall back to the section's blocks / image setting.
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign steps = mf.steps.value
  assign image = mf.steps_image.value | default: section.settings.image
  if image == blank and product.images.size > 2
    assign image = product.images[2]
  endif
-%}
<div class="kh">
  <section class="discovery-experience section-space">
    <div class="kh-wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 class="section-title">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="discovery-experience-layout">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image.alt, sizes: '(min-width: 801px) 50vw, 100vw', widths: '500, 800, 1200' }}
        {%- endif -%}
        <div class="discovery-steps">
          {%- if steps != blank -%}
            {%- for step in steps -%}
              {%- assign icon = step.icon.value | default: 'sparkles' | downcase -%}
              <article>
                <div class="discovery-step-icon">
                  {%- render 'kh-icon', name: icon -%}
                  <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                </div>
                <div>
                  <h3>{{ step.title.value }}</h3>
                  <p>{{ step.text.value }}</p>
                </div>
              </article>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <article {{ block.shopify_attributes }}>
                <div class="discovery-step-icon">
                  {%- render 'kh-icon', name: block.settings.icon -%}
                  <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                </div>
                <div>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Khrisha discovery steps",
  "tag": "section",
  "class": "kh-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A more personal way to discover" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six scents. Endless possibilities." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Used when custom.steps_image is empty. Defaults to the product's third image." },
    { "type": "paragraph", "content": "Steps come from the product's custom.steps metafield (Discovery step metaobjects). When it is empty, the blocks below are used." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "flask", "options": [{ "value": "flask", "label": "Flask" }, { "value": "heart", "label": "Heart" }, { "value": "sparkles", "label": "Sparkles" }, { "value": "gift", "label": "Gift" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your collection" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Khrisha discovery steps", "blocks": [{ "type": "step" }] }]
}
{% endschema %}
